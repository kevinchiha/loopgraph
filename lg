#!/usr/bin/env python3
"""lg — thin CLI for loopgraph-engine.

`lg start <run-dir> [repo]` runs a brief; `lg status <workflow-id|run-dir>`
prints what a run is doing; `lg approve <workflow-id> <answer>` answers a
waiting one; `lg gate`, `lg round` and `lg prompt` drive the pieces on their
own. `lg --help` lists them all.
"""

from __future__ import annotations

import argparse
import asyncio
import json
import os
import shutil
import subprocess
import sys
import tomllib
import uuid
from datetime import datetime, timezone

from temporalio.client import Client, WorkflowExecutionStatus
from temporalio.service import RPCError, RPCStatusCode

import version
from envfile import read_env

ROOT = os.path.dirname(os.path.abspath(__file__))
ADDRESS = os.environ.get("TEMPORAL_ADDRESS", "localhost:7233")
TASK_QUEUE = "loopgraph"
# Long enough for a slow network, short enough that a person waiting on
# `lg version` gets an answer rather than a hung terminal.
REMOTE_TIMEOUT = 10
# The connect and the listing of open runs together. Short, because a stack that
# is down is the ordinary reason this takes any time at all.
TEMPORAL_TIMEOUT = 10
# The fetch in `lg update`. Generous, because it is one round trip to GitHub on
# whatever network the user has, and it is the only thing standing between them
# and knowing whether there is a release.
FETCH_TIMEOUT = 60.0
# The one streamed compose command in `lg update`. Long, because a --build pulls
# base images and compiles wheels on whatever machine the user has.
STACK_TIMEOUT = 1800.0
# Each captured compose read: the `ps` and one log poll.
POLL_TIMEOUT = 60.0
# Each git command `lg rm` runs against a target repository. Both only touch that
# repository's own records — no network, no checkout — so a minute is already
# generous; it is here so a repository on a filesystem that stopped answering
# reaches the report as a failed line instead of holding the command open.
WORKTREE_TIMEOUT = 60.0
# The wait between log polls, named so a test can make it a no-op. Sixty tries
# two seconds apart is the two minutes a restarted stack gets to say it is up.
_sleep = asyncio.sleep


def _dotenv() -> dict[str, str]:
    """The repo's .env, which install.sh writes. Absent before the first install.

    ROOT is read here rather than at import, so a test can point it at a tmp_path.
    """
    return read_env(os.path.join(ROOT, ".env"))


async def _client() -> Client:
    return await Client.connect(ADDRESS)


async def cmd_gate(args: argparse.Namespace) -> int:
    client = await _client()
    wf_id = f"gate-{uuid.uuid4().hex[:8]}"
    handle = await client.start_workflow(
        "GateCheckRun",
        args=[args.gates, args.workdir],
        id=wf_id,
        task_queue=TASK_QUEUE,
    )
    print(f"workflow {wf_id} started")
    try:
        result = await handle.result()
    except Exception as e:
        try:
            status = await handle.query("status")
        except Exception:  # the workflow died before it recorded anything
            print(f"FAILED: {e}", file=sys.stderr)
            return 1
        print(json.dumps(status, indent=2))
        # Only say "red gates" when gates actually went red. Saying it for every
        # failure named zero gates and hid whatever really went wrong.
        if status.get("red"):
            print(f"BLOCKED: red gates -> {', '.join(status['red'])}", file=sys.stderr)
        else:
            print(f"FAILED (no gate went red): {e}", file=sys.stderr)
        return 1
    print(json.dumps(result, indent=2))
    return 0


def run_slug(arg: str) -> str:
    """The run directory an argument names: `x`, `runs/x` and `runs/x/` are one run."""
    parts = [p for p in arg.split("/") if p]
    return parts[-1] if parts else ""


def resolve_run_arg(arg: str, candidates: list[tuple[str, datetime]]) -> tuple[str | None, int]:
    """Which workflow a run-directory slug names, and how many claimed it.

    An id given in full wins outright. Otherwise the id has to be `run-<slug>-`
    plus a token holding no `-`, which is the shape cmd_start builds and the
    inverse of ui.run_entry's id[4:id.rfind("-")]. Without the no-dash rule
    the slug `foo` would swallow every run whose own slug starts with `foo-`.
    """
    for wf_id, _ in candidates:
        if wf_id == arg:
            return arg, 1
    prefix = f"run-{run_slug(arg)}-"
    matches = [(wf_id, start) for wf_id, start in candidates
               if wf_id.startswith(prefix)
               and wf_id[len(prefix):] and "-" not in wf_id[len(prefix):]]
    if not matches:
        return None, 0
    return max(matches, key=lambda m: m[1])[0], len(matches)


def _round_verdict(entry: dict) -> str:
    """What a round says where its verdict goes.

    The entry is written before the audit starts, so a round with no verdict is
    two different pieces of news and they must not read alike: `escalated` means
    the gates stayed red and no audit ever ran, `green` means the audit is still
    out. The gate word `green` itself never goes here — it would read as an
    acceptance the supervisor has not made.
    """
    if entry.get("verdict"):
        return str(entry["verdict"])
    return {"escalated": "escalated", "green": "audit running"}.get(entry.get("status"), "")


# The sweep section's copy, in one dictionary because the dashboard prints the
# same lines and cannot share them: `lg` has no extension, so `ui.py` cannot
# import from it. A test reads these templates, strips the placeholders and
# looks for the fixed text on the page, which is the only thing holding the
# terminal and the browser to the same words.
SWEEP_LINES = {
    "pass": "pass {n}: {k} candidates",
    "pass_incomplete": "pass {n}: {k} candidates (incomplete: {names})",
    "pass_groups": "pass {n}: {k} candidates ({groups})",
    "pass_incomplete_groups": "pass {n}: {k} candidates (incomplete: {names}) ({groups})",
    "ended": "ended: {reason}",
    "none": "(no passes yet)",
}


def _group_breakdown(entries: list[dict] | None) -> str:
    """A pass's candidates by path group: `<name> <count>`, joined by `, `.

    Summed across the pass's detectors, because two tools reporting the same
    directory are one number the owner reads, not two. Sorted by name and not by
    the order the detectors were run in: the loop rotates through the detectors,
    so encounter order would move a directory around the line from one pass to
    the next and nothing about the repo would have changed.

    Empty when no detector carries `groups` — every pass recorded before this
    phase — and the v1 line prints instead of empty brackets.
    """
    counts: dict[str, int] = {}
    for entry in entries or []:
        for group in entry.get("groups") or []:
            counts[group.get("name", "")] = (counts.get(group.get("name", ""), 0)
                                             + group.get("count", 0))
    return ", ".join(f"{name} {counts[name]}" for name in sorted(counts))


def format_status(ledger: dict) -> str:
    """A run's ledger as something readable in a terminal.

    Every key is optional, because this is handed ledgers older than half the
    keys it reads: a run that closed before `items` was a ledger key hands back
    a dictionary with no `items` at all, and two runs on this machine do exactly
    that. `ledger["items"]` on one of those is a traceback where the owner asked
    a plain question.
    """
    head = [f"status: {ledger.get('status', '')}"]
    if "reason" in ledger:
        head.append(f"reason: {ledger['reason']}")
    sections = [head]

    awaiting = ledger.get("awaiting")
    if awaiting:
        block = [f"awaiting: {awaiting.get('kind', '')}"]
        question = awaiting.get("question")
        if question:
            # Printed as recorded, line breaks and all: it is the text of the card
            # the owner saw, and nothing here rebuilds it from the kind and letters.
            block += [f"  {line}" if line else "" for line in str(question).splitlines()]
        else:
            block.append("  question not recorded")
        block += [f"  {letter} — {label}"
                  for letter, label in (awaiting.get("options") or {}).items()]
        block.append(f"  answer with: {awaiting.get('answer_with', '')}")
        if not awaiting.get("telegram"):
            # The dashboard says this sentence too, and a test pins the two equal.
            # Nothing was sent to the owner's phone, so a run that is waiting looks
            # stuck until something says why.
            block.append("  no card was sent; the lg approve command is the only way to answer")
        sections.append(block)

    items = ["items:"]
    for entry in ledger.get("items") or []:
        detail = ""
        if entry.get("status") == "done":
            detail = str(entry.get("commit") or "")[:10]
        elif entry.get("status") == "parked":
            detail = str(entry.get("reason") or "")
        # A removal item and a detector's item are the engine's own work, and
        # nothing else on the line says so. An entry from a run older than `kind`
        # has no key: those runs had brief items and nothing else.
        kind = entry.get("kind", "brief")
        word = "" if kind == "brief" else f"{kind} "
        # A sweep item takes one path group, and which one is all that tells two
        # items of the same detector apart. An item from before the rotation has
        # no `group`, and a convergence item never had one.
        if kind == "sweep" and entry.get("group"):
            word += f"{entry['group']} "
        items.append(f"  {entry.get('n', '')} {entry.get('status', '')} "
                     f"{word}{detail}".rstrip())
    if len(items) == 1:
        items.append("  (none yet)")
    sections.append(items)

    sweep = ledger.get("sweep") or {}
    if sweep:
        block = ["sweep:"]
        passes = sweep.get("passes") or []
        for p in passes:
            # A non-empty note means there is something to read about that
            # detector: it died, or its output was cut at 1 MiB. Names print
            # only on an incomplete pass, and a pass is incomplete only when a
            # detector died, so what the owner sees here is the tool to go and
            # look at; a cut on an otherwise green pass stays in the ledger.
            names = ", ".join(d.get("name", "") for d in p.get("detectors") or []
                              if d.get("note"))
            # The count says how much is left, the breakdown says where it is,
            # which is what tells a rotation working through the repo from one
            # circling a single directory. A pass with nothing to break down
            # prints the line it printed before groups existed.
            groups = _group_breakdown(p.get("detectors"))
            key = "pass" if p.get("complete") else "pass_incomplete"
            block.append("  " + SWEEP_LINES[key + "_groups" if groups else key].format(
                n=p.get("pass", ""), k=p.get("total", ""), names=names, groups=groups))
        if not passes:
            block.append("  " + SWEEP_LINES["none"])
        if sweep.get("ended"):
            block.append("  " + SWEEP_LINES["ended"].format(reason=sweep["ended"]))
        sections.append(block)

    rounds = ["rounds:"]
    for entry in ledger.get("rounds") or []:
        # item_no arrived after the first runs. Those were single-item runs, so
        # item 1 is what they were, and it is the default the dashboard uses too.
        word = _round_verdict(entry)
        rounds.append(f"  item {entry.get('item_no') or 1} round {entry.get('round', '')} {word}"
                      .rstrip())
    if len(rounds) == 1:
        rounds.append("  (none yet)")
    sections.append(rounds)

    return "\n\n".join("\n".join(s) for s in sections) + "\n"


def _first_line(e: Exception) -> str:
    """One line for the terminal. A traceback is not an answer to a plain question."""
    lines = str(e).splitlines()
    return lines[0] if lines and lines[0].strip() else type(e).__name__


async def _still_running(handle) -> bool:
    """Whether waiting on this workflow's result would block.

    temporalio types WorkflowExecution.status as optional and leaves it None when
    Temporal reports no status, so unknown has to fall one way. It falls the way
    ui._still_running falls it — unknown counts as running — because the two
    mistakes are not equal: skipping the fallback prints one line, and taking it
    on a run that is waiting for its owner holds the terminal for as long as the
    card is up.
    """
    status = (await handle.describe()).status
    return status is None or status is WorkflowExecutionStatus.RUNNING


async def _answer(handle, queries: list[str]) -> tuple[str, object]:
    """The first query that answers, as (query name, result).

    A NOT_FOUND is not a query failure — it says the id does not exist — so it
    comes straight back out and the caller reads the argument as a run directory
    instead. Anything else just moves to the next query. When `ledger` was among
    the queries that failed, a finished run still has its ledger: it is the value
    the workflow returned, and a query on a closed run makes the worker replay
    its whole history against the workflow code registered now — a history
    written by older code diverges and the query dies with a nondeterminism
    error, not a decoding one. Half the runs on a long-lived engine are in that
    state. That is the fallback ui._ledger already makes.
    """
    failure: Exception = RuntimeError("no query to ask")
    for q in queries:
        try:
            return q, await handle.query(q)
        except RPCError as e:
            if e.status is RPCStatusCode.NOT_FOUND:
                raise
            failure = e
        except Exception as e:
            failure = e
    if "ledger" in queries and not await _still_running(handle):
        return "result", await handle.result()
    raise failure


async def _resolve_id(client, arg: str) -> str | None:
    """The workflow a run-directory argument names, saying out loud when it chose."""
    candidates = [(wf.id, wf.start_time)
                  async for wf in client.list_workflows('WorkflowType = "LoopGraphRun"')]
    wf_id, count = resolve_run_arg(arg, candidates)
    slug = run_slug(arg)
    if wf_id is None:
        print(f"no workflow for {slug}; looked for ids starting run-{slug}-", file=sys.stderr)
        return None
    if count > 1:
        print(f"using {wf_id} (newest of {count} for {slug})", file=sys.stderr)
    return wf_id


async def cmd_status(args: argparse.Namespace) -> int:
    """What a run is doing, named by workflow id or by run directory.

    The argument is a workflow id first, exactly as before; only Temporal saying
    no such workflow exists turns it into a run-directory slug. stdout carries
    the summary or the JSON and nothing else — every notice goes to stderr.
    """
    client = await _client()
    queries = [args.query] if args.query else ["status", "ledger"]
    try:
        try:
            name, result = await _answer(client.get_workflow_handle(args.workflow_id), queries)
        except RPCError as e:
            if e.status is not RPCStatusCode.NOT_FOUND:
                raise
            wf_id = await _resolve_id(client, args.workflow_id)
            if wf_id is None:
                return 1
            # A miss on the id just chosen is a plain failure, not a second lookup.
            name, result = await _answer(client.get_workflow_handle(wf_id), queries)
    except Exception as e:
        print(_first_line(e), file=sys.stderr)
        return 1
    # GateCheckRun and RoundRun answer `status` and have no ledger to summarise.
    if args.json or args.query or name == "status":
        print(json.dumps(result, indent=2))
    else:
        print(format_status(result), end="")
    return 0


async def cmd_round(args: argparse.Namespace) -> int:
    client = await _client()
    wf_id = f"round-{uuid.uuid4().hex[:8]}"
    handle = await client.start_workflow(
        "RoundRun",
        args=[args.run_dir, args.target_repo, args.work_item, args.round_no],
        id=wf_id,
        task_queue=TASK_QUEUE,
    )
    print(f"workflow {wf_id} started", flush=True)
    result = await handle.result()
    print(json.dumps(result, indent=2))
    return 0 if result["status"] == "green" else 1


def _container(path: str) -> str:
    """lg runs on the host; workflows speak container paths."""
    return "/app/" + path if path.startswith("runs/") else path


# The engine root, mounted at /app. The projects tree is ui.CONTAINER_PROJECTS,
# borrowed rather than copied: a second spelling of "/projects/" is a drift away
# from the dashboard resolving a repository the CLI has just refused.
CONTAINER_APP = "/app/"


def unreachable(what: str, path: str, projects_dir: str | None, root: str) -> str:
    """Why the container cannot reach `path`, or "" when it can.

    Two host directories are mounted into the worker: this checkout, as `/app`,
    and the tree named by LOOPGRAPH_PROJECTS_DIR, as `/projects`. A path under
    neither does not exist in there. `_container` rewrites `runs/<slug>` and
    nothing else, so an absolute host path — the one a shell tab-completes, and
    the only one the owner has ever needed for that repository — reached Temporal
    untouched, started a run, and died on the first git command with a bare
    `FileNotFoundError`, delivered to the owner's phone as `engine failure:` with
    neither the cause nor the fix in it.

    Nothing here needs the container. `lg` runs on the host, where both mounted
    trees are ordinary directories, so the same check that the worker fails is
    one `isdir` away before the connection is even made — which is also what
    catches a mistyped repository name or run slug, the identical error from the
    identical git command.

    `projects_dir` comes from .env and is `None` before the first install; a
    `/projects/...` path then passes, because nothing on this machine maps it and
    a refusal would be a guess. It is expanded and its trailing slash dropped:
    install.sh writes what the owner typed without normalising it, and matching
    on the raw string would refuse a correct setup.
    """
    import ui
    tree = os.path.expanduser(projects_dir or "").rstrip("/")
    for prefix, base in ((ui.CONTAINER_PROJECTS, tree), (CONTAINER_APP, root)):
        if not path.startswith(prefix):
            continue
        if not base:
            return ""
        host = os.path.join(base, path[len(prefix):])
        if os.path.isdir(host):
            return ""
        return f"{what} {path} is not on this machine: no directory {host}."
    said = (f"{what} {path} is a path on this machine, and the engine runs in a "
            f"container that cannot see it.")
    # The whole translation, when there is one to give. Compared with the slash
    # on, so `<dir>projects-old` is not read as a directory inside `<dir>projects`
    # and answered with a container path that exists on neither side of the mount.
    if tree and path.startswith(tree + "/"):
        return f"{said} Use {ui.CONTAINER_PROJECTS}{path[len(tree) + 1:]} instead."
    if tree:
        return (f"{said} Only {tree} is mounted, as /projects, so the repo has to "
                f"live under it.")
    return (f"{said} Target repos are named /projects/<name>; "
            f"LOOPGRAPH_PROJECTS_DIR is not set, so run ./install.sh.")


# The engine could not finish. NOT the same as the owner saying no: the workflow
# overwrites "merge-ready" with the owner's answer before it returns, so treating
# that one status as the only success meant every finished run, including a clean
# merge, reported failure to whatever was scripting it.
FAILED_STATES = ("stopped", "merge-failed", "discard-failed")


def exit_code_for(status: str) -> int:
    return 1 if status in FAILED_STATES else 0


async def cmd_start(args: argparse.Namespace) -> int:
    run_dir = _container(args.run_dir)
    target = _container(args.target_repo) if args.target_repo else run_dir + "/target"
    # Before the connection, so a path the worker cannot reach costs nothing: no
    # workflow, no card, no worktree, and a reason the owner can act on.
    projects_dir = _dotenv().get("LOOPGRAPH_PROJECTS_DIR")
    for what, path in (("run dir", run_dir), ("target repo", target)):
        why = unreachable(what, path, projects_dir, ROOT)
        if why:
            print(why, file=sys.stderr)
            return 1
    client = await _client()
    wf_id = f"run-{run_dir.rsplit('/', 1)[-1]}-{uuid.uuid4().hex[:6]}"
    handle = await client.start_workflow(
        "LoopGraphRun",
        args=[run_dir, target, args.work_item or ""],
        id=wf_id,
        task_queue=TASK_QUEUE,
    )
    print(f"workflow {wf_id} started", flush=True)
    ledger = await handle.result()
    print(json.dumps(ledger, indent=2))
    return exit_code_for(ledger.get("status", ""))


async def cmd_prompt(args: argparse.Namespace) -> int:
    """Dry-run: print the exact executor prompt a run would get (no Claude call)."""
    from activities.execute_round import assemble_prompt
    from pathlib import Path
    run = Path(args.run_dir)
    brief = (run / "brief.md").read_text()
    constraints = (run / "constraints.md").read_text() if (run / "constraints.md").exists() else ""
    print(assemble_prompt(brief, constraints, args.work_item or brief))
    return 0


async def cmd_tail(args: argparse.Namespace) -> int:
    """Follow the live stream logs of a run (executor + supervisor, as they work)."""
    import os
    from pathlib import Path
    from activities.stream import LOG_GLOB
    # Names carry the item and round (i2-r1-audit.log). A glob pinned to the old
    # r<N>- shape matched nothing at all, so this command found no logs, ever.
    logs = sorted(Path(args.run_dir, "logs").glob(LOG_GLOB))
    if not logs:
        print(f"no logs yet under {args.run_dir}/logs", file=sys.stderr)
        return 1
    os.execvp("tail", ["tail", "-n", "+1", "-F", *[str(l) for l in logs]])
    return 0  # unreachable


async def cmd_approve(args: argparse.Namespace) -> int:
    """Answer a waiting run without Telegram. Same effect as tapping the card."""
    client = await _client()
    await client.get_workflow_handle(args.workflow_id).signal("decide", args.value)
    print(f"sent {args.value!r} to {args.workflow_id}")
    return 0


async def cmd_where(args: argparse.Namespace) -> int:
    """Where everything is on THIS machine. The skill reads this instead of guessing."""
    env = _dotenv()
    projects = env.get("LOOPGRAPH_PROJECTS_DIR", "(unset - run ./install.sh)")
    telegram = env.get("LOOPGRAPH_TELEGRAM_ENV", "")
    bot = env.get("LOOPGRAPH_TELEGRAM_BOT", "")
    on = bool(telegram and os.path.exists(os.path.expanduser(telegram)))
    info = {
        "engine_root": ROOT,
        "projects_dir": projects,
        "projects_in_container": "/projects",
        "run_dir_in_container": "/app/runs/<slug>",
        "docker": env.get("LOOPGRAPH_DOCKER", "docker"),
        "temporal_address": ADDRESS,
        "temporal_ui": "http://localhost:8233/namespaces/default/workflows",
        "dashboard": "http://localhost:8400",
        "telegram": {"configured": on, "bot": bot or None, "env_file": telegram or None},
        "answer_a_run": ("tap the card in Telegram, or: lg approve <workflow-id> A"
                         if on else "lg approve <workflow-id> A"),
    }
    print(json.dumps(info, indent=2))
    return 0


def installed_line(info: dict) -> str:
    """What version.installed found, in the words a person reads.

    One copy of the wording because two commands print it: `lg version` beside
    `installed:`, and `lg update` as the release it moved you off.
    """
    if info["commit"] is None:
        return "untagged (not a git checkout)"
    if info["tag"] is None:
        return f"untagged ({info['commit']})"
    if info["ahead"]:
        return f"{info['tag']} +{info['ahead']} commits ({info['commit']})"
    return info["tag"]


async def cmd_version(args: argparse.Namespace) -> int:
    """What you have installed, and whether origin has a newer release.

    ROOT is read here rather than at import, the way _dotenv reads it, so a test
    can point the whole command at a repository under tmp_path.

    An unreachable origin is news, not a failure: the question "what am I
    running" has an answer offline, so the reason is printed beside `latest:`
    and the exit code stays 0. Only RemoteError is caught — anything else is a
    bug in the engine and should arrive as a traceback, not as a shrug.
    """
    here = version.installed(ROOT)
    latest, error = None, None
    try:
        latest = version.remote_newest(ROOT, REMOTE_TIMEOUT)
    except version.RemoteError as e:
        error = str(e)
    behind = version.is_behind(here["tag"], latest)

    if args.json:
        print(json.dumps({"installed": here["tag"], "commit": here["commit"],
                          "ahead": here["ahead"], "latest": latest,
                          "behind": behind, "error": error}, indent=2))
        return 0

    print(f"installed: {installed_line(here)}")
    if error is not None:
        print(f"latest: unknown (could not reach origin: {error})")
    elif latest is None:
        print("latest: none (origin has no releases yet)")
    else:
        # Hung off `behind` rather than on the two tags being equal, so a
        # checkout sitting past the newest release — a maintainer's, mid-phase —
        # is told it is up to date instead of being offered a move backwards.
        print(f"latest: {latest}" if behind else f"latest: {latest} (up to date)")
    if behind:
        print("update: run lg update")
    return 0


def _run(argv: list[str], cwd: str, timeout: float | None = None,
         stream: bool = False) -> subprocess.CompletedProcess[str]:
    """One external command, which always comes back as a result.

    Every command `lg update` runs goes through this one door, so a test can
    replace it and watch a whole update without a binary running. Nothing here
    raises: subprocess raises both for a command that hangs and for a program
    that is not installed, and a traceback at the moment the update has already
    moved the checkout is the one output this command must never produce. Both
    arrive as a failed result instead, on the codes a shell uses for them — 124
    for a timeout, 127 for a missing binary — so they reach the same one-line
    message paths as any other failure.

    `stream=True` hands the terminal to the command, so a build shows progress
    and a `sudo docker` can ask for its password. There is nothing to capture
    then, and the result says as much with empty text.
    """
    try:
        if stream:
            done = subprocess.run(argv, cwd=cwd, timeout=timeout)
            return subprocess.CompletedProcess(argv, done.returncode, "", "")
        return subprocess.run(argv, cwd=cwd, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(argv, 124, "", f"timed out after {timeout:g}s")
    except FileNotFoundError as e:
        return subprocess.CompletedProcess(argv, 127, "", str(e))


async def _open_runs() -> list:
    """Every workflow Temporal still calls running, of any type.

    Connect and listing in one coroutine so a single deadline covers both: the
    listing sends no request until it is iterated, so a connect that succeeded
    proves nothing about the server behind it.
    """
    client = await _client()
    return [wf async for wf in client.list_workflows('ExecutionStatus = "Running"')]


def _said(text: str) -> str:
    """The first line of a command's output worth showing a person.

    Empty when there is nothing to show, which the callers answer for
    themselves: a streamed command has already put its output on the terminal
    and has only its exit code left to report.
    """
    return next((line.strip() for line in text.splitlines() if line.strip()), "")


def _file(path: str) -> str:
    """A file from the checkout, empty when the release did not ship it."""
    if not os.path.exists(path):
        return ""
    with open(path, encoding="utf-8") as f:
        return f.read()


def _changelog(root: str) -> str:
    """The checkout's CHANGELOG.md, empty when the release did not ship one."""
    return _file(os.path.join(root, "CHANGELOG.md"))


def _dep_name(spec: str) -> str:
    """The package a dependency string names, without its version or its extras."""
    for i, ch in enumerate(spec):
        if ch in ">=<!~ [;":
            return spec[:i]
    return spec


def _host_deps(pyproject: str) -> list[str]:
    """What the host venv installs of a release's dependencies.

    This list is the pip fallback's, and it installs what install.sh's pip path
    installs: every declared dependency except claude-agent-sdk, for the reason
    install.sh gives beside its own list. The uv path tried first syncs the whole
    file and never asks. A pyproject.toml nothing could read leaves the list
    empty rather than raising — the refresh is already running after a merge that
    succeeded.
    """
    try:
        project = tomllib.loads(pyproject).get("project", {})
    except tomllib.TOMLDecodeError:
        return []
    return [d for d in project.get("dependencies", []) if _dep_name(d) != "claude-agent-sdk"]


def _refresh_venv(root: str, new_pyproject: str) -> subprocess.CompletedProcess[str]:
    """Bring the host venv in line with the dependencies the release ships.

    uv when the machine has one, because that is what install.sh built the venv
    with. The fallback runs `.venv/bin/python -m pip` and never `.venv/bin/pip`:
    a venv uv built has no pip script in it at all.

    Both get STACK_TIMEOUT, the deadline the compose build runs under and for the
    same reason: a resolver waiting on an index that stopped answering would
    otherwise hang here for good, with the checkout already on the new release
    and nothing on the terminal to say what it is waiting for.
    """
    if shutil.which("uv"):
        return _run(["uv", "sync"], root, timeout=STACK_TIMEOUT)
    python = os.path.join(root, ".venv", "bin", "python")
    deps = _host_deps(new_pyproject)
    return _run([python, "-m", "pip", "install", "--quiet", "--upgrade", *deps, "pytest"],
                root, timeout=STACK_TIMEOUT)


async def _restart_stack(root: str, docker: str, action: str, tag: str) -> int:
    """Put the running stack on the new code, and wait until it says it is there.

    Every compose command runs from `root`, because compose reads
    docker-compose.yml from the directory it is called in. The one that changes
    the stack is streamed, so a --build shows its progress and a `sudo docker`
    can ask for a password; the reads around it are captured, because their
    output is what this function is reading.
    """
    compose = [*docker.split(), "compose"]
    listed = _run([*compose, "ps", "--services", "--status", "running"], root,
                  timeout=POLL_TIMEOUT)
    if listed.returncode != 0:
        # Never read as "nothing is running": docker-compose.yml guards its
        # required settings with ${VAR:?}, which fails every subcommand with an
        # empty stdout, and exiting 0 here would leave a worker on the old code
        # under a message saying the stack was down.
        print(f"compose failed: {_said(listed.stderr)}", file=sys.stderr)
        return 1
    if "worker" not in listed.stdout.split():
        build = " --build" if action == "build" else ""
        print(f"the stack is not running; start it with: "
              f"cd {root} && {docker} compose up -d{build}")
        return 0

    # Taken before the command that changes the stack, so the polls below read
    # this restart's banners and not the ones from the last time it came up.
    stamp = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    argv = {
        "build": [*compose, "up", "-d", "--build", "worker", "dispatcher"],
        # No --build: compose recreates the containers whose configuration
        # moved, which is what a docker-compose.yml change needs and what
        # `restart` — the old container, re-run as it was created — cannot do.
        "recreate": [*compose, "up", "-d", "worker", "dispatcher"],
        "restart": [*compose, "restart", "worker", "dispatcher"],
    }[action]
    started = _run(argv, root, timeout=STACK_TIMEOUT, stream=True)
    if started.returncode != 0:
        reason = _said(started.stderr) or f"exit {started.returncode}"
        print(f"compose failed: {reason}", file=sys.stderr)
        return 1

    # What each service prints when it is ready: worker.py's line, and the one
    # dispatcher.py prints once Telegram has answered it.
    banners = {"worker": "worker up on task queue", "dispatcher": "dispatcher up"}
    waiting = list(banners)
    # Tries with a wait between them rather than a wall-clock deadline, so the
    # timeout is testable in milliseconds. Sixty of them is the two minutes.
    for _ in range(60):
        for service in list(waiting):
            logs = _run([*compose, "logs", "--since", stamp, service], root,
                        timeout=POLL_TIMEOUT)
            if logs.returncode != 0:
                print(f"compose failed: {_said(logs.stderr)}", file=sys.stderr)
                return 1
            if banners[service] in logs.stdout:
                waiting.remove(service)
        if not waiting:
            print(f"now on {tag}")
            return 0
        await _sleep(2)

    # No --since here: when the restart never took, that window holds nothing
    # and "log above" would sit over an empty space. install.sh prints the
    # unfiltered log at the same moment for the same reason.
    tail = _run([*compose, "logs", "--tail", "20", "worker", "dispatcher"], root,
                timeout=POLL_TIMEOUT)
    print(tail.stdout, end="")
    print(f"the {' and '.join(waiting)} did not come up after the update (log above)",
          file=sys.stderr)
    return 1


def relink_skill(root: str, home: str) -> str | None:
    """Point this home's `~/.claude/skills/loopgraph` at this checkout's skill.

    install.sh makes that path a symlink, and a symlink needs nothing from an
    update: the merge rewrites SKILL.md under it and the agent reads the new one
    on its next session. This is here for every machine that is anything else —
    a link left behind by a clone that has since moved, or one nobody ever made
    — because those go stale silently and stay stale through every update.

    A real directory is the one case that is left alone. It is a copy somebody
    made, possibly with their own edits in it, and deleting a user's writing to
    fix a link is a trade nobody agreed to; the returned line says what to
    remove instead. `home` is an argument rather than read from the environment
    so a test can be given one under tmp_path.

    Returns the line to print, or None when there was nothing to do.
    """
    src = os.path.join(root, "skills", "loopgraph")
    if not os.path.isdir(src):
        return None
    dst = os.path.join(home, ".claude", "skills", "loopgraph")
    # islink before exists, in that order: a link whose target is gone answers
    # False to exists, and reading it as "nothing is there" would try to create
    # a symlink on top of one and raise FileExistsError.
    if os.path.islink(dst):
        if os.path.realpath(dst) == os.path.realpath(src):
            return None
        os.remove(dst)
        verb = "re-pointed"
    elif os.path.exists(dst):
        return (f"{dst} is a copy, not a link to {src}\n"
                "  it did not follow this update; remove it and run lg update again")
    else:
        verb = "linked"
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    os.symlink(src, dst)
    return f"{verb} {dst} -> {src}\n  restart your agent session to pick up the skill"


async def cmd_update(args: argparse.Namespace) -> int:
    """Move a clean main to the newest release origin has.

    Every refusal below happens before anything on disk moves, and each one names
    what the user has to do about it. They run cheapest first: a dirty tree is
    answered without waiting on the network, and the network is answered without
    waiting on Temporal.

    ROOT is read here rather than at import, the way cmd_version reads it, so a
    test can point the whole command at a repository under tmp_path.
    """
    root = ROOT

    def git(*argv: str, timeout: float | None = None) -> subprocess.CompletedProcess[str]:
        return _run(["git", *argv], root, timeout=timeout)

    if git("status", "--porcelain", "--untracked-files=no").stdout.strip():
        print(f"refuse: uncommitted changes in {root}. "
              "Commit or stash them, then run lg update again.", file=sys.stderr)
        return 1

    branch = git("branch", "--show-current").stdout.strip()
    if not branch:
        print("refuse: not on a branch (detached HEAD). lg update only moves main.",
              file=sys.stderr)
        return 1
    if branch != "main":
        print(f"refuse: on branch {branch}, not main. lg update only moves main.",
              file=sys.stderr)
        return 1

    fetched = git("fetch", "--tags", "--quiet", "origin", timeout=FETCH_TIMEOUT)
    if fetched.returncode != 0:
        # A git that failed silently still has to say something, the way
        # version.remote_newest falls back for the same case: a refusal whose
        # reason is the empty string tells the user nothing at all.
        reason = _said(fetched.stderr) or f"git fetch exited {fetched.returncode}"
        print(f"refuse: could not reach origin: {reason}", file=sys.stderr)
        return 1

    tag = version.newest(git("tag", "--list", "v*").stdout.split())
    if tag is None:
        print("refuse: origin has no releases yet.", file=sys.stderr)
        return 1

    old_commit = git("rev-parse", "HEAD").stdout.strip()
    # release.sh tags annotated, so the tag object has a hash of its own and
    # `<tag>^{commit}` is the only thing HEAD can be compared with.
    if old_commit and old_commit == git("rev-parse", f"{tag}^{{commit}}").stdout.strip():
        print(f"already on {tag}")
        return 0
    if git("merge-base", "--is-ancestor", tag, "HEAD").returncode == 0:
        # Counted from the tag being moved to, not from the tag this checkout is
        # described by: on a maintainer's tree those are two different releases.
        ahead = git("rev-list", "--count", f"{tag}..HEAD").stdout.strip()
        print(f"already past {tag} (HEAD is {ahead} commits ahead)")
        return 0

    try:
        open_runs = await asyncio.wait_for(_open_runs(), TEMPORAL_TIMEOUT)
    except Exception:
        # Every way this can fail reads the same to the user and has the same
        # fix, and none of them may end as a traceback in front of an update that
        # has not started: without an answer here the command cannot know whether
        # restarting the stack would drop a run mid-question.
        print(f"refuse: cannot reach Temporal at {ADDRESS}. "
              "Start the stack so lg update can check for open runs.", file=sys.stderr)
        return 1
    if open_runs:
        print(f"refuse: {len(open_runs)} open run(s). Answer or finish them first:",
              file=sys.stderr)
        for workflow in open_runs:
            print(f"  {workflow.id}    lg status {workflow.id}", file=sys.stderr)
        return 1

    # These three reads go through version._git rather than the _run above, so
    # they never reach the recorder the AC-14 test counts git commands off; they
    # are describe, rev-parse and rev-list, and the guard in tests/test_ui.py is
    # what keeps that list read-only.
    here = version.installed(root)
    old, old_tag = installed_line(here), here["tag"]
    if git("merge", "--ff-only", tag).returncode != 0:
        print(f"refuse: main and {tag} have diverged; git status will show why.",
              file=sys.stderr)
        return 1

    print(f"updated {old} → {tag}")
    notes = version.changelog_between(_changelog(root), old_tag, tag)
    print(notes or f"(no changelog entry for {tag})")

    # After the merge, so the link is made to a skill that is already the new
    # one, and before every branch below that can return early: a user who is
    # sent off to edit .env still gets told their agent is reading a stale copy.
    relinked = relink_skill(root, os.path.expanduser("~"))
    if relinked:
        print(relinked)

    def shown(path: str) -> str:
        """That file as the old commit had it, empty when it had none."""
        done = git("show", f"{old_commit}:{path}")
        return done.stdout if done.returncode == 0 else ""

    changed = git("diff", "--name-only", old_commit, tag).stdout.splitlines()
    old_pyproject = shown("pyproject.toml")
    new_pyproject = _file(os.path.join(root, "pyproject.toml"))
    # What the stack needs is decided by what moved inside pyproject.toml, never
    # by its being in the diff: release.sh rewrites its version line every time.
    action = version.stack_action(changed, old_pyproject, new_pyproject)

    if version.needs_venv(old_pyproject, new_pyproject):
        refreshed = _refresh_venv(root, new_pyproject)
        if refreshed.returncode != 0:
            # The merge already happened, and the stack is deliberately left
            # alone: a worker restarted onto code the venv cannot import is
            # worse off than one still running the release before it.
            reason = _said(refreshed.stderr) or _said(refreshed.stdout)
            print(f"venv refresh failed: {reason}", file=sys.stderr)
            return 1

    # The settings check comes after the venv refresh, not before it: install.sh
    # only builds a venv when there is none, so stopping here first would leave
    # the host lg short of a dependency this release just started importing.
    env = _dotenv()
    docker = env.get("LOOPGRAPH_DOCKER", "docker")
    keys = version.new_settings(shown(".env.example"),
                               _file(os.path.join(root, ".env.example")), env)
    if keys:
        # Exit 2, and no compose command: the code is on the new release and the
        # `updated ...` line above says so. What is missing is the user's answer
        # to a question this release started asking.
        print(f"new settings since {old}: {', '.join(keys)}. "
              f"Add them to .env (see .env.example for what each means), "
              f"then start the stack: cd {root} && {docker} compose up -d")
        return 2

    return await _restart_stack(root, docker, action, tag)


def _registered_worktrees(listing: str) -> list[str]:
    """Every path a repository has registered, as `git worktree list` printed it.

    One `worktree <path>` line per registration, and `<path>` is the string git
    itself recorded — not a path on this machine. A run the engine made
    registered its container path, `/app/runs/<slug>/worktrees/<token>`, because
    `git worktree add` ran inside the container.
    """
    return [line[len("worktree "):] for line in listing.splitlines()
            if line.startswith("worktree ")]


def clean_worktrees(slug: str, runs_dir: str, projects_dir: str | None) -> list[str]:
    """De-register each worktree under runs/<slug>/worktrees/ from its repository.

    Returns one line per worktree it could NOT de-register; empty list means all
    clean. It deletes nothing itself: the run directory is the caller's to remove.

    Every line starts with the worktree it is about, because AC-24 says each one
    is reported by name and the reasons alone do not carry it: two worktrees of a
    run stopped by a missing .env give the same sentence twice, and two identical
    lines report neither of them. A worktree that resolves and simply has no
    registration left is reported as nothing at all — it is already out of that
    repository, and a line crying failure over work that is done is the same lie
    in the other direction.

    Every registration is named one at a time, by the path the repository
    recorded for it, and NOTHING here prunes. Measured on git 2.39.5 against a
    repository holding two runs' worktrees, both registered under container paths
    the way the engine writes them:

      - `worktree remove --force <host path>` exits 128, `is not a working tree`.
        Git matches on the path it recorded and no host path equals it, so the
        host path is never the argument.
      - `worktree prune` exits 0 having removed EVERY loopgraph registration in
        that repository, the run that is live right now included, leaving no
        .git/worktrees directory at all. `-c gc.worktreePruneExpire=never` changed
        nothing — a bare prune never consults that setting — and afterwards the
        live run's next git command dies with `fatal: not a git repository`, which
        `worktree repair` cannot undo from the host. Tidying a finished run off
        the rail while its replacement works the same project is the ordinary use
        of `lg rm`, so this is the everyday case, not an exotic race.
      - `worktree remove --force <the recorded container path>` exits 0, takes
        that one registration out, and leaves the other run's records and both
        branches alone. That is the mechanism.
      - The same command a second time exits 128. That is why the repository is
        asked what it has registered first: without that, every `lg rm` over an
        already-de-registered worktree would file a failure line for work that is
        done.

    `activities/checkpoint.py`'s `discard` keeps its own remove-then-prune and its
    branch delete. It runs inside the container, where every recorded path exists
    and nothing looks stale, and the owner refusing a run is a different act from
    tidying up after one. Neither rule travels to the other.
    """
    # Both imported here rather than at the top of the file, the way cmd_ui
    # imports ui and cmd_prompt imports Path: `lg` is one process per command,
    # and a module-top import would charge every `lg status` the dashboard's.
    from pathlib import Path
    import ui

    runs = Path(runs_dir)
    worktrees = runs / slug / "worktrees"
    try:
        names = sorted(entry.name for entry in worktrees.iterdir() if entry.is_dir())
    except OSError:
        # No worktrees directory: a run that never reached an executor round, or
        # one a `discard` already cleaned out. Nothing to de-register and nothing
        # to report — this is the state the caller is trying to reach.
        return []

    report: list[str] = []
    # The listing is per repository, not per worktree: a run with several
    # worktrees in one repository asks it once, and a repository that will not
    # answer is asked once and reported against each of its worktrees. The value
    # is (what it has registered, why it could not be asked) — one of the two is
    # always empty.
    listings: dict[Path, tuple[list[str], str]] = {}

    for name in names:
        # The container path is what the resolver takes, and reusing it buys the
        # pointer-file parsing, the /projects/ prefix swap and every failure line
        # ui.resolve_repo already gets right.
        in_container = f"{ui.CONTAINER_RUNS}{slug}/worktrees/{name}"
        repo, why = ui.resolve_repo(in_container, runs, projects_dir)
        if repo is None:
            # The repository moved, .env is missing, the pointer file is gone.
            # Nothing can be de-registered from a repository this machine cannot
            # find, and the next worktree may well be in one it can. The reason is
            # the resolver's, word for word; only the name in front of it is ours.
            report.append(f"{name}: {why}")
            continue

        if repo not in listings:
            listed = _run(["git", "worktree", "list", "--porcelain"], str(repo),
                          timeout=WORKTREE_TIMEOUT)
            if listed.returncode == 0:
                listings[repo] = (_registered_worktrees(listed.stdout), "")
            else:
                listings[repo] = ([], _said(listed.stderr) or f"exit {listed.returncode}")
        registered, refused = listings[repo]
        if refused:
            report.append(f"{name}: could not list the worktrees of {repo}: {refused}")
            continue

        # Two exact candidates and no suffix match: the container path a run made
        # inside the container registered, and the host directory a worktree made
        # on this machine would have. Matching on a suffix would let one run's
        # token claim a registration that merely ends the same way.
        candidates = (in_container, str(worktrees / name))
        recorded = next((path for path in registered if path in candidates), None)
        if recorded is None:
            # The repository has no registration for it, so it is already out of
            # that repository. No command runs and nothing is reported: a line
            # crying failure over work that is done is the same lie the other way.
            continue

        # Named by the path git listed, never by the path this machine sees.
        # Removing it also deletes the directory at that path if there is one: on
        # the host `/app/runs/...` is not there, so the worktree directory
        # survives for the caller to delete, and in the host-registered case git
        # deletes the same directory the caller would have. Neither is a failure.
        removed = _run(["git", "worktree", "remove", "--force", recorded], str(repo),
                       timeout=WORKTREE_TIMEOUT)
        if removed.returncode != 0:
            reason = _said(removed.stderr) or f"exit {removed.returncode}"
            report.append(f"{name}: {reason}")
    return report


async def _run_workflows(slug: str) -> tuple[Client, list]:
    """The client, and every LoopGraphRun workflow of run directory `slug`.

    Connect and listing in one coroutine so a single deadline covers both, the
    way `_open_runs` does it for `lg update`: the listing sends no request until
    it is iterated, so a connect that succeeded proves nothing about the server
    behind it.

    A run's ids are `run-<slug>-` plus a token holding no `-` — the shape
    cmd_start builds and resolve_run_arg inverts. Every one of them, not the
    newest: two workflows can share a run directory, and the dashboard keys its
    rows on the workflow id, so archiving one and not the other leaves a row on
    the rail pointing at logs and a diff that are gone. The no-dash rule is what
    keeps `foo` off every run whose own slug starts with `foo-`.
    """
    client = await _client()
    prefix = f"run-{slug}-"
    found = [wf async for wf in client.list_workflows('WorkflowType = "LoopGraphRun"')
             if wf.id.startswith(prefix) and wf.id[len(prefix):]
             and "-" not in wf.id[len(prefix):]]
    return client, found


async def cmd_rm(args: argparse.Namespace) -> int:
    """Delete one run directory: refuse, confirm, de-register, delete, archive.

    The order is the design. `runs/<slug>` holds the owner's work and sometimes a
    client's — the executor's transcripts, the supervisor's reasoning, the gates,
    the worktrees — it is gitignored because it is theirs, and there is no undo.
    So everything that can say no says it before anything is removed: the name,
    then the directory, then Temporal, then the operator.

    The worktrees go before the directory, because clean_worktrees finds them by
    reading `runs/<slug>/worktrees/` and after the rmtree there is nothing left
    to read. The archive write goes last, because a row taken off the rail by a
    delete that then failed is a run the owner can no longer see and has not
    lost. Neither half is optional: a directory deleted with its rows left on the
    rail leaves the dashboard listing a run whose every pane is gone.
    """
    from pathlib import Path
    import ui

    # ROOT, .env and the archive path are all read here rather than at import,
    # the way _dotenv and cmd_version read them, so a test can put the whole
    # command under a tmp_path. This one has to be movable: it deletes.
    runs_dir = Path(ROOT) / "runs"
    slug = run_slug(args.run_dir)

    # AC-28, and the first thing the command does. run_slug validates nothing,
    # whatever its docstring suggests: it splits on `/`, drops the empties and
    # returns the last part, so `.`, `..` and `` all come through it unchanged.
    # Every later stop then lets them past — all three directories exist, so the
    # missing-directory check passes; `run-.-` matches no workflow, and a run
    # with no workflow is not a refusal; and the prompt asks the operator to
    # retype the same `.` they just typed, or to press Enter for the empty one.
    # So without this, `lg rm .` and `lg rm ./` delete every run directory,
    # `lg rm ..` takes the checkout with it, and `lg rm --yes "$SLUG"` with SLUG
    # unset empties runs/ and exits 0. It sits above the directory check, the
    # Temporal check and the prompt, and --yes does not reach it.
    if (ui.bad_param(slug)
            # The three forms this takes and no others: `x`, `runs/x`, `runs/x/`
            # (Path drops the trailing slash and a leading `./` for us).
            # Normalising `a/b` or `/elsewhere/runs/b` down to `b` would delete a
            # run the operator never named.
            or Path(args.run_dir) not in (Path(slug), Path("runs") / slug)
            # And the directory that names has to be a child of runs/ once every
            # symlink in it is followed, which is what resolve() does: a
            # `runs/evil` pointing at the home directory passes both checks above.
            or (runs_dir / slug).resolve().parent != runs_dir.resolve()):
        print(f"not a run name: {args.run_dir}", file=sys.stderr)
        return 1

    run = runs_dir / slug
    if not run.is_dir():
        # Archiving a row whose directory was never there is the dashboard's job.
        # Here it is a typo far more often than anything else, and saying so is
        # not worth a round trip to Temporal.
        print(f"no run directory runs/{slug}", file=sys.stderr)
        return 1

    try:
        client, workflows = await asyncio.wait_for(_run_workflows(slug), TEMPORAL_TIMEOUT)
    except Exception:
        # Every way this fails reads the same to the owner and has the same fix.
        # A run mid-round has a worktree an executor is writing into, and a stack
        # that cannot be asked cannot rule that out — guessing is the one thing a
        # command with no undo may not do (AC-21).
        print(f"cannot reach Temporal at {ADDRESS}; "
              "lg rm cannot prove the run is not mid-round", file=sys.stderr)
        return 1

    # Open is the close time and never the ledger's `status`. An activity that
    # escapes `run` leaves the workflow closed with its ledger frozen at the
    # failure — reading `running`, sometimes still holding an `awaiting` — for
    # ever, and those dead runs are exactly what this command is for. Temporal
    # answering with no matching workflow at all is not a refusal either: that is
    # the state a logs-only run, one driven by `lg round`, is always in.
    still_open = [wf for wf in workflows if wf.close_time is None]
    for wf in still_open:
        try:
            waiting = bool((await client.get_workflow_handle(wf.id).query("ledger"))
                           .get("awaiting"))
        except Exception:
            # A query replays the whole history against the workflow code
            # registered now, so one written by older code fails outright. The
            # workflow is open either way, and that is all this line has to be
            # right about.
            waiting = False
        if waiting:
            print(f"refuse: {wf.id} is waiting on you — answer it: "
                  f"lg approve {wf.id} <answer>", file=sys.stderr)
        else:
            print(f"refuse: {wf.id} is still running", file=sys.stderr)
    if still_open:
        return 1

    wf_ids = [wf.id for wf in workflows]
    try:
        worktrees = sorted(p for p in (run / "worktrees").iterdir() if p.is_dir())
    except OSError:  # a run that never reached a round, or one `discard` cleaned
        worktrees = []
    print(f"about to delete {run}")
    for worktree in worktrees:
        print(f"  worktree {worktree}")
    for wf_id in wf_ids:
        print(f"  archive {wf_id}")

    if not args.yes:
        # The slug back, not `y`: `y` is what a person types without reading, and
        # this is the last thing standing between the argument and an rmtree.
        try:
            typed = input(f"type {slug} to delete, or anything else to stop: ")
        except Exception:
            # A read that gets no line at all is not the slug. `input()` raises
            # EOFError from a pipe or `< /dev/null`, RuntimeError when fd 0 was
            # closed before the process started (`lost sys.stdin`), ValueError
            # when it closes under us. main() has no top-level handler, and a
            # traceback is not an answer to a plain question — every other
            # refusal in `lg` is one line and a 1.
            typed = ""
        if typed != slug:
            print("stopped; nothing was touched", file=sys.stderr)
            return 1

    # Report lines do not stop what follows (AC-24): a registration that cannot
    # be taken out from this machine cannot be taken out at all, and leaving the
    # directory behind as well helps nobody.
    for line in clean_worktrees(slug, str(runs_dir), _dotenv().get("LOOPGRAPH_PROJECTS_DIR")):
        print(line, file=sys.stderr)
    try:
        shutil.rmtree(run)
    except OSError as e:
        # A read-only runs/, a file another process is holding, a filesystem that
        # stopped answering. rmtree deletes what it can and raises, so what is
        # left is a part of the run, and the rows stay on the rail deliberately:
        # a row nobody can see over logs still sitting on disk is worse than a
        # run that is simply still there. Never `ignore_errors=True` — that turns
        # this into `removed runs/<slug>` printed over a directory that is not
        # gone, which is the one thing this command may not say.
        print(f"could not delete runs/{slug}: {_first_line(e)}", file=sys.stderr)
        return 1

    archived = 0
    # Nothing to record means nothing is written: an empty write would create the
    # file on a fresh checkout and reformat the owner's own for no reason.
    if wf_ids:
        try:
            # Through mark_archived and never by opening the file here. It
            # re-reads immediately before it writes, under its own lock, because
            # the dashboard can be writing the same file on two threads while
            # this runs in a process of its own.
            ui.mark_archived(runs_dir, wf_ids, True)
            archived = len(wf_ids)
        except ui.ArchiveUnreadable:
            # The directory and the worktrees are already gone and no exit code
            # puts them back. Telling the owner the rows are still on the rail
            # beats pretending the command failed.
            print("runs/.archived.json is not a readable list; "
                  "move it aside and archive by hand", file=sys.stderr)
    print(f"removed runs/{slug}; archived {archived} workflow row(s)")
    return 0


async def cmd_ui(args: argparse.Namespace) -> int:
    import ui
    ui.serve(args.port)
    return 0


def main() -> int:
    p = argparse.ArgumentParser(prog="lg")
    sub = p.add_subparsers(dest="cmd", required=True)
    g = sub.add_parser("gate", help="run a gates.yaml through the gate workflow")
    g.add_argument("gates")
    g.add_argument("workdir", nargs="?", default="/app")
    g.set_defaults(fn=cmd_gate)
    s = sub.add_parser("status", help="read a run: lg status <workflow-id|run-dir> [ledger]")
    s.add_argument("workflow_id", metavar="arg",
                   help="a workflow id, or a run directory like runs/2026-09-05-feature")
    s.add_argument("query", nargs="?", default=None,
                   help="one query by name; ledger prints the raw ledger as JSON")
    s.add_argument("--json", action="store_true",
                   help="print the raw query result instead of the summary")
    s.set_defaults(fn=cmd_status)
    r = sub.add_parser("round", help="run one executor round on a work item")
    r.add_argument("run_dir", help="run dir with brief.md/constraints.md/gates.yaml (container path)")
    r.add_argument("target_repo", help="git repo the round works on (container path)")
    r.add_argument("work_item")
    r.add_argument("--round-no", type=int, default=1)
    r.set_defaults(fn=cmd_round)
    st = sub.add_parser("start", help="start a full LoopGraphRun on a run dir")
    st.add_argument("run_dir", help="e.g. runs/2026-09-05-feature (brief.md inside)")
    st.add_argument("target_repo", nargs="?", help="git repo to work on (default: <run_dir>/target)")
    st.add_argument("work_item", nargs="?", default="", help="defaults to the whole brief")
    st.set_defaults(fn=cmd_start)
    pr = sub.add_parser("prompt", help="dry-run the executor prompt for a run dir")
    pr.add_argument("run_dir")
    pr.add_argument("work_item", nargs="?", default="")
    pr.set_defaults(fn=cmd_prompt)
    t = sub.add_parser("tail", help="follow a run's live executor/supervisor streams")
    t.add_argument("run_dir")
    t.set_defaults(fn=cmd_tail)
    ap = sub.add_parser("approve", help="answer a waiting run without Telegram")
    ap.add_argument("workflow_id")
    ap.add_argument("value", help="a letter (A/B/C) for merge cards, free text for questions")
    ap.set_defaults(fn=cmd_approve)
    w = sub.add_parser("where", help="paths, ports and Telegram status on this machine")
    w.set_defaults(fn=cmd_where)
    v = sub.add_parser("version",
                       help="what you have installed, and whether origin has a newer release")
    v.add_argument("--json", action="store_true",
                   help="print one JSON object instead of the lines")
    v.set_defaults(fn=cmd_version)
    up = sub.add_parser("update",
                        help="move a clean main to the newest release and restart the stack")
    up.set_defaults(fn=cmd_update)
    rm = sub.add_parser("rm", help="delete a run directory and archive its rows")
    rm.add_argument("run_dir", help="the run to delete: my-run, runs/my-run or runs/my-run/")
    rm.add_argument("--yes", action="store_true", help="skip the confirmation prompt")
    rm.set_defaults(fn=cmd_rm)
    u = sub.add_parser("ui", help="web dashboard → http://localhost:8400")
    u.add_argument("--port", type=int, default=8400)
    u.set_defaults(fn=cmd_ui)
    args = p.parse_args()
    return asyncio.run(args.fn(args))


if __name__ == "__main__":
    sys.exit(main())
