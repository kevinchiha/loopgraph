.venv/
__pycache__/
*.pyc
.env
# install.sh backs up an existing .env before writing a new one, and that copy
# holds the same credentials.
.env.backup.*
.pytest_cache/

# Runs belong to you, not to this project. Everything under runs/ is ignored and
# the shipped examples below are the only exceptions, so a run you create is
# invisible to git without anyone having to remember a rule.
runs/*
!runs/m1-demo/
!runs/m2-toy/
!runs/m3-accept/
!runs/m3-planted-lie/
!runs/m4-cards/
!runs/example-hello/

# ...but never the scratch a run produces, even inside a shipped example.
runs/*/worktrees/
runs/*/logs/
runs/*/target/
# constraints.md is scratch too, though it does not look like it: `learn` appends
# to it after every accepted item, so a tracked one accumulates whatever the last
# person to run the example happened to learn. The example-hello copy shipped five
# constraints telling every executor the scope gate was vacuously green, true when
# they were written and false since the shebang was fixed, and two agents in one
# live run spent claims re-litigating them. Both readers treat a missing file as
# "(none yet)" and `append_constraint` creates it, so nothing needs it in git.
runs/*/constraints.md

# Playwright MCP drops console logs and screenshots here whenever a browser is
# driven from this directory. Scratch, and it carries whatever site was open.
.playwright-mcp/

# docs/ is a scratch pad: phase specs, plans, gap reports, and the generated
# architecture diagram. They are how a change got built, not part of the engine,
# and they run to megabytes of machine-generated text nobody reads. Kept on disk,
# out of the repo. README screenshots live in screenshots/ so they still ship.
docs/

# Knowledge graph built by graphify. Regenerated by the post-commit
# hook, so committing it would just churn a large JSON blob.
graphify-out/
