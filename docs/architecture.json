  "cards": [
    {
      "dot": "cyan",
      "title": "Durable outside",
      "items": [
        "Temporal owns the timers, retries and signals between nodes",
        "The ledger is workflow state, readable live through a query handler",
        "A reboot mid-run resumes from the event history"
      ]
    },
    {
      "dot": "emerald",
      "title": "The loop inside the node",
      "items": [
        "LangGraph runs produce, gate and correct inside one activity",
        "Three attempts, then the round escalates instead of trying again",
        "Each accepted round appends one line to constraints.md, carried by every later prompt"
      ]
    },
    {
      "dot": "rose",
      "title": "What keeps it honest",
      "items": [
        "Gates are commands judged on exit code, never a model",
        "The supervisor never sees the executor transcript - only claims, write set, diff and gate results, with read-only tools",
        "checkpoint re-runs the gates, stages only declared paths, and never pushes"
      ]
    }
  ]
