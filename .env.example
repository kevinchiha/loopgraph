# Copy to .env, or let ./install.sh write it for you. Never commit .env.

# ---------------------------------------------------------------- executor ---
# The engine drives a headless Claude. Pick ONE of the two routes below.
#
# Route 1 (recommended): CLIProxyAPI + a Claude subscription.
#   A run spends up to three executor rounds plus an audit pass, so metered
#   billing adds up fast. CLIProxyAPI runs locally, signs in with your Claude
#   subscription and speaks the Anthropic API, so the engine talks to it instead.
#   See https://github.com/router-for-me/CLIProxyAPI
#   ANTHROPIC_AUTH_TOKEN is the proxy's own local api-key, not an Anthropic key.
ANTHROPIC_BASE_URL=http://127.0.0.1:8317
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=claude-opus-5
#
# Route 2: a plain Anthropic API key, billed per token.
#   Comment out the three lines above and use these instead:
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5

# ------------------------------------------------------------------- paths ---
# The only tree the worker can reach. Target repos must live under it.
LOOPGRAPH_PROJECTS_DIR=/home/you/projects
# npm cache shared with the container, so gates running `npm ci` in a fresh
# worktree don't re-download the world every round.
LOOPGRAPH_NPM_CACHE=/home/you/.npm
# Your uid, so files the agent writes are owned by you and not by root.
LOOPGRAPH_UID=1000

# ---------------------------------------------------------------- telegram ---
# Optional. Without it, answer a run with `lg approve <workflow-id> A`.
# With it, decisions arrive on your phone as cards with buttons, which is much
# better than watching a terminal for a run that takes 40 minutes to need you.
# The credentials live in their own file (mode 600), never in here.
LOOPGRAPH_TELEGRAM_ENV=/home/you/.config/loopgraph-telegram.env
# Set to 1 once you have configured a bot: the worker then refuses to start
# without the credentials, instead of failing later when a card is due.
LOOPGRAPH_REQUIRE_TELEGRAM=0
